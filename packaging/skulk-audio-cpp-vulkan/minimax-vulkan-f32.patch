diff --git a/include/engine/community_models/minimax_music3/vulkan_precision.h b/include/engine/community_models/minimax_music3/vulkan_precision.h
new file mode 100644
index 0000000..238b6fa
--- /dev/null
+++ b/include/engine/community_models/minimax_music3/vulkan_precision.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include "engine/framework/core/module.h"
+
+#include <ggml.h>
+
+namespace engine::models::minimax_music3 {
+
+// MiniMax's quantized projections amplify F16 accumulation error on Vulkan.
+// Keep this policy in the family adapter: other families and backends retain
+// their existing precision, and the Vulkan KV cache still uses upstream F16.
+inline ggml_prec vulkan_matmul_precision(core::BackendType backend_type) {
+    return backend_type == core::BackendType::Vulkan ? GGML_PREC_F32 : GGML_PREC_DEFAULT;
+}
+
+// Stamp the completed MiniMax graph before allocation/pipeline selection.
+// This also covers attention and projections constructed by shared modules.
+inline void apply_vulkan_matmul_precision(core::BackendType backend_type, ggml_cgraph * graph) {
+    if (backend_type != core::BackendType::Vulkan) {
+        return;
+    }
+    for (int index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+        ggml_tensor * node = ggml_graph_node(graph, index);
+        if (node->op == GGML_OP_MUL_MAT) {
+            ggml_mul_mat_set_prec(node, GGML_PREC_F32);
+        }
+    }
+}
+
+}  // namespace engine::models::minimax_music3
